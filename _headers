# Disable search engine indexing on Cloudflare Pages default domain and preview URLs
https://play-2048-online.pages.dev/*
  X-Robots-Tag: noindex

https://*.play-2048-online.pages.dev/*
  X-Robots-Tag: noindex

# Global security headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Service worker (always fresh)
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Compiled static stylesheet
/styles.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cache headers and MIME types for SEO & Core Web Vitals
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/og-image-2048.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=604800, immutable

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=604800, immutable

/favicon.ico
  Cache-Control: public, max-age=604800, immutable
