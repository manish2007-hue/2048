# Disable search engine indexing on Cloudflare Pages default domain and preview URLs
https://play-2048-online.pages.dev/*
  X-Robots-Tag: noindex

https://*.play-2048-online.pages.dev/*
  X-Robots-Tag: noindex

# Cache headers and MIME types for SEO files
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
